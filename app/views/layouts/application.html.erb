<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} | Eagle Vision" : "Eagle Vision" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <% if user_signed_in? %>
      <%= render "layouts/topbar" %>
      <main class="page">
        <% flash.each do |kind, message| %>
          <div class="flash <%= kind %>" role="status"><%= message %></div>
        <% end %>
        <%= yield %>
      </main>
    <% else %>
      <main class="auth">
        <div class="auth-card">
          <% flash.each do |kind, message| %>
            <div class="flash <%= kind %>" role="status"><%= message %></div>
          <% end %>
          <%= yield %>
        </div>
      </main>
    <% end %>
  </body>
</html>
