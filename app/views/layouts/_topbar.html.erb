<header class="topbar" data-controller="menu">
  <div class="topbar-inner">
    <%= link_to root_path, class: "brand" do %>Eagle<span>Vision</span><% end %>
    <button type="button" class="quiet small menu-toggle" data-action="menu#toggle" aria-label="Menu">Menu</button>
    <nav class="nav" aria-label="Main">
      <% nav_links.each do |link| %>
        <%= link_to link[:path], class: ("active" if link[:active]) do %>
          <%= link[:label] %><% if link[:count].to_i.positive? %><span class="count"><%= link[:count] %></span><% end %>
        <% end %>
      <% end %>
    </nav>
    <div class="topbar-right">
      <%= render "terms/picker" %>
      <span class="muted small"><%= viewer_display_name %></span>
      <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "quiet small", form: { data: { turbo: false } } %>
    </div>
  </div>
</header>
