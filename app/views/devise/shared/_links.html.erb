<div class="auth-links">
  <%- if controller_name != "sessions" %>
    <%= link_to "Sign in", new_session_path(resource_name) %>
  <% end %>
  <%- if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to "Create an account", new_registration_path(resource_name) %>
  <% end %>
  <%- if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <%= link_to "Forgot your password?", new_password_path(resource_name) %>
  <% end %>
  <%- if devise_mapping.omniauthable? && ENV["GOOGLE_OAUTH_CLIENT_ID"].present? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Sign in with Google", omniauth_authorize_path(resource_name, provider), method: :post,
                    class: "secondary", data: { turbo: false } %>
    <% end %>
  <% end %>
</div>
